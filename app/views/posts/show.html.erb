<div class=" w-1/2 mx-auto my-5">
  <%= link_to "← 一覧に戻る", posts_path, class: "text-blue-500" %>
</div>
<div class="flex justify-between w-1/2 mx-auto my-5 items-center">
  <h2 class="font-bold text-xl">お試し</h2>
  <%= link_to "編集", edit_post_path(@post), class: "border text-blue-500 border-blue py-2 px-6 rounded" %>
</div>
<div class="w-1/2 mx-auto bg-white p-8">
  <table class="border w-full border-gray-300">
    <tr class="border-b border-gray-300">
      <th class="text-left w-1/3 p-4">開始日</th>
      <td class="w-2/3 p-4"><%= l(@post.start_date, format: :default) %></td>
    </tr>
    <tr class="border-b border-gray-300">
      <th class="text-left w-1/3 p-4">終了日</th>
      <td class="w-2/3 p-4"><%= l(@post.end_date, format: :default) %></td>
    </tr>
    <tr class="border-b border-gray-300">
      <th class="text-left w-1/3 p-4">終日</th>
      <td class="w-2/3 p-4"><%= @post.all_day ? "⚪︎" : "" %></td>
    </tr>
    <tr>
      <th class="text-left p-4 w-1/3">スケジュールメモ</th>
      <td class="w-2/3 p-4"><%= @post.memo %></td>
    </tr>
  </table>
</div>
