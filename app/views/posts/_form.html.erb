<%= form_with model: @post do |form| %>
  <%= render "shared/error_messages", object: form.object %>
  <div class="flex flex-col mb-4">
    <%= form.label :title, class: "mb-2 font-bold" do %>
      タイトル<sup class="text-red-500">✴︎</sup>
    <% end %>
    <%= form.text_field :title, class: "border border-gray-300 p-2", placeholder: "タイトル" %>
  </div>
  <div class="flex mb-4 gap-4">
    <div class="flex flex-col flex-1">
      <%= form.label :start_date, class: "mb-1 font-bold" do %>
        開始日<sup class="text-red-500">✴︎</sup>
      <% end %>
      <%= form.date_field :start_date, class: "border border-gray-300 p-2" %>
    </div>
    <div class="flex flex-col flex-1">
      <%= form.label :end_date, class: "mb-1 font-bold" do %>
        終了日<sup class="text-red-500">✴︎</sup>
      <% end %>
      <%= form.date_field :end_date, class: "border border-gray-300 p-2" %>
    </div>
  </div>
  <div class="mb-4 flex items-center gap-2">
    <%= form.check_box :all_day, class: "w-5 h-5" %>
    <%= form.label :all_day, "終日の場合はチェックを入れます" %>
  </div>
  <div class="flex flex-col mb-4">
    <%= form.label :memo, "スケジュールメモ", class: "mb-2 font-bold"%>
    <%= form.text_area :memo, class: "border border-gray-300 p-2", placeholder: "メモを入力する" %>
  </div>
  <div class="mb-4 flex justify-end gap-2">
    <%= link_to "キャンセル", posts_path , class: "inline-flex h-10 items-center border border-gray-300 cursor-pointer font-bold py-2 px-4 rounded" %>
    <%= form.submit "保存", class: "inline-flex h-10 items-center bg-blue-500 hover:bg-blue-700 cursor-pointer text-white font-bold py-2 px-4 rounded" %>
  </div>
<% end %>